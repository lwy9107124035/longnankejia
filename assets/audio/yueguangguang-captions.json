    {
      "text": "月光光，秀才郎。",
      "meaning": "月光明亮，唱起秀才郎。",
      "ipa": "ȵiot⁴⁵ koŋ³⁵ koŋ³⁵，ɕiu⁵⁵ tsʰoi²¹³ loŋ²¹³。"
    },
    {
      "text": "骑白马，过莲塘。",
      "meaning": "骑着白马，经过莲塘。",
      "ipa": "tɕʰi²¹³ pʰa³³ ma³¹，ko⁵⁵ liɛn²¹³ tʰoŋ²¹³。"
    },
    {
      "text": "莲塘背，栽韭菜。",
      "meaning": "莲塘后面，种着韭菜。"
    },
    {
      "text": "韭菜花，结亲家。",
      "meaning": "韭菜开花，两家结为亲家。",
      "ipa": "tɕiu³¹ tsʰoi⁵⁵ fa³⁵，tɕiɛt²¹ tɕʰin³⁵ ka³⁵。"
    },
    {
      "text": "亲家门前一眼塘，",
      "meaning": "亲家门前有一口池塘。"
    },
    {
      "text": "养只鲤拐八尺长。",
      "meaning": "养的鲤鱼有八尺长，是童谣中的夸张说法。"
    },
    {
      "text": "长的拿来伴酒食，",
      "meaning": "长的拿来当下酒菜。"
    },
    {
      "text": "短的拿来做学堂。",
      "meaning": "短的拿来建学堂，是童谣中的想象。"
    },
    {
      "text": "结亲家。",
      "meaning": "结为亲家，是前句的重复唱词。",
      "ipa": "tɕiɛt²¹ tɕʰin³⁵ ka³⁵。"
    },
    {
      "text": "做个学堂四四方，",
      "meaning": "建一座四四方方的学堂。"
    },
    {
      "text": "两个姐妹拜月光。",
      "meaning": "两位姐妹向月亮行礼。"
    },
    {
      "text": "拜得月光。",
      "meaning": "拜月光，是前句的重复唱词。"
    },
    {
      "text": "马又走，马又走，",
      "meaning": "马又跑开了，马又跑开了。"
    },
    {
      "text": "追的马来天又光。",
      "meaning": "追着马儿，天又亮了。"
    },
    {
      "text": "天又光。",
      "meaning": "天又亮了，是前句的重复唱词。"
    }
  ]
